    },
    "%@ in this category move to the Trash, and the folder \"%@\" is deleted. Press ⌘Z to put the photos back. A file that is not in this category stays, and so does the folder." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ trong danh mục này sẽ được chuyển vào Thùng rác, và thư mục \"%@\" sẽ bị xóa. Nhấn ⌘Z để trả ảnh về. Tệp không thuộc danh mục này vẫn được giữ lại, thư mục cũng vậy."
          }
        }
      }
    },
